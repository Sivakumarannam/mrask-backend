DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. To use SQLite while learning, delete or comment out POSTGRES_DB.
POSTGRES_DB=portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Needed only when DJANGO_DEBUG=False (production). Comma separated.
CORS_ALLOWED_ORIGINS=https://your-portfolio.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
