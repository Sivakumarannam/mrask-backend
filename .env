# URL of the Django API. Restart Expo after changing it: npx expo start -c
# Web / iOS simulator: http://localhost:8000
# Android emulator:    http://10.0.2.2:8000
# Real phone (Expo Go): http://YOUR-PC-IP:8000  (run Django with: python manage.py runserver 0.0.0.0:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

